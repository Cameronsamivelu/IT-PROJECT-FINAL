<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#082b50">
    <title>Customer Login | ANGEL</title>

    <link rel="icon" href="{{ url_for('static', filename='images/angel-favicon.ico') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/auth.css') }}">
</head>

<body class="auth-page">
<main class="auth-shell">

    <aside class="auth-brand">
        <div class="brand-top">
            <div class="brand-logo">
                <img
                    src="{{ url_for('static', filename='images/angel-logo.png') }}"
                    alt="ANGEL logo"
                    onerror="this.style.display='none'"
                >
            </div>

            <div>
                <p class="brand-name">ANGEL</p>
                <p class="brand-tagline">Airport luggage guidance</p>
            </div>
        </div>

        <div class="brand-copy">
            <p class="brand-eyebrow">Your customer portal</p>
            <h1>Keep every bag <span>within reach.</span></h1>
            <p>
                Sign in to check your luggage details and keep your
                journey moving with greater peace of mind.
            </p>
        </div>

        <ul class="brand-points">
            <li class="brand-point">
                <span class="point-icon">✓</span>
                <span>See your registered luggage in one place</span>
            </li>

            <li class="brand-point">
                <span class="point-icon">↗</span>
                <span>Find your tracking details when you need them</span>
            </li>
        </ul>

        <p class="brand-footer">
            A smoother journey starts with ANGEL.
        </p>
    </aside>

    <section class="auth-panel">
        <p class="auth-kicker">Customer account</p>
        <h2 class="auth-title">Welcome back</h2>
        <p class="auth-description">
            Enter your details to access your ANGEL account.
        </p>

        {% with messages = get_flashed_messages(with_categories=True) %}
            {% for category, message in messages %}
                <div class="flash {{ category }}" role="status">
                    {{ message }}
                </div>
            {% endfor %}
        {% endwith %}

        <form
            class="auth-form"
            action="{{ url_for('user_login') }}"
            method="POST"
        >
            <div class="form-field">
                <label for="username">Username</label>
                <input
                    type="text"
                    id="username"
                    name="username"
                    autocomplete="username"
                    placeholder="Enter your username"
                    required
                    autofocus
                >
            </div>

            <div class="form-field">
                <label for="password">Password</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    autocomplete="current-password"
                    placeholder="Enter your password"
                    required
                >
            </div>

            <div class="form-options">
                <a
                    class="text-link"
                    href="{{ url_for('user_forgot_password') }}"
                >
                    Forgot password?
                </a>
            </div>

            <button class="primary-button" type="submit">
                Log in to ANGEL <span aria-hidden="true">→</span>
            </button>
        </form>

        <p class="auth-footnote">
            New to ANGEL?
            <a class="text-link" href="{{ url_for('user_register') }}">
                Create an account
            </a>
        </p>

        <a class="auth-home-link" href="{{ url_for('home') }}">
            ← Back to homepage
        </a>
    </section>

</main>
</body>
</html>