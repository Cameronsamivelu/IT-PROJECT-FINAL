
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Customer | ANGEL</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f3f6fa;
            margin: 0;
            padding: 30px;
            color: #172033;
        }

        .container {
            max-width: 550px;
            margin: 40px auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 18px rgba(0,0,0,0.08);
        }

        h1 {
            color: #17365d;
        }

        label {
            display: block;
            margin-top: 18px;
            font-weight: bold;
        }

        input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            margin-top: 7px;
            border: 1px solid #ccd4df;
            border-radius: 6px;
        }

        button, .back {
            display: inline-block;
            margin-top: 22px;
            padding: 12px 18px;
            border: none;
            border-radius: 6px;
            text-decoration: none;
            cursor: pointer;
            font-size: 15px;
        }

        button {
            background: #17365d;
            color: white;
        }

        .back {
            background: #e5eaf1;
            color: #172033;
            margin-left: 8px;
        }

        .message {
            color: #b42318;
            margin-top: 12px;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Edit Customer</h1>

        <p>Customer ID: {{ customer["id"] }}</p>

        {% with messages = get_flashed_messages() %}
            {% for message in messages %}
                <p class="message">{{ message }}</p>
            {% endfor %}
        {% endwith %}

        <form method="POST">
            <label for="full_name">Full Name</label>
            <input
                type="text"
                id="full_name"
                name="full_name"
                value="{{ customer['full_name'] }}"
                required
            >

            <label for="username">Username</label>
            <input
                type="text"
                id="username"
                name="username"
                value="{{ customer['username'] }}"
                required
            >

            <button type="submit">Save Changes</button>

            <a class="back"
               href="{{ url_for('customers') }}">
                Cancel
            </a>
        </form>
    </div>
</body>
</html>
