
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ANGEL - Register Luggage</title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='css/style.css') }}">

    <style>
        /* Header and dashboard navigation */

        .admin-header .admin-header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }

        .admin-header-brand {
            text-align: left;
        }

        .dashboard-back-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 16px;
            border: 1px solid #fff;
            border-radius: 8px;
            background: #fff;
            color: #0d477f;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            transition: background 0.2s ease;
        }

        .dashboard-back-button:hover {
            background: #eaf4ff;
        }

        .dashboard-back-button:focus-visible {
            outline: 3px solid #93c5fd;
            outline-offset: 3px;
        }

        /* Searchable airport fields */

        .airport-autocomplete {
            position: relative;
            width: 100%;
            margin-bottom: 18px;
        }

        .airport-autocomplete input {
            display: block;
            width: 100%;
            box-sizing: border-box;
            padding: 13px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: #fff;
            color: #203047;
            font: inherit;
            outline: none;
        }

        .airport-autocomplete input:focus {
            border-color: #1674c4;
            box-shadow: 0 0 0 3px rgba(22, 116, 196, 0.12);
        }

        .airport-suggestions[hidden] {
            display: none !important;
        }

        .airport-suggestions {
            position: absolute;
            top: calc(100% + 5px);
            left: 0;
            right: 0;
            z-index: 1000;
            max-height: 280px;
            overflow-y: auto;
            background: #fff;
            border: 1px solid #dce5ef;
            border-radius: 9px;
            box-shadow: 0 12px 30px rgba(15, 40, 70, 0.16);
        }

        .airport-option {
            display: block;
            width: 100%;
            padding: 12px 14px;
            text-align: left;
            border: 0;
            border-bottom: 1px solid #edf1f6;
            background: #fff;
            color: #203047;
            cursor: pointer;
        }

        .airport-option:last-child {
            border-bottom: 0;
        }

        .airport-option:hover,
        .airport-option.active {
            background: #edf6ff;
        }

        .airport-option-name {
            display: block;
            font-size: 14px;
            font-weight: 700;
            line-height: 1.45;
        }

        .airport-option-details {
            display: block;
            margin-top: 4px;
            color: #64748b;
            font-size: 12px;
            line-height: 1.5;
        }

        .airport-code {
            display: inline-block;
            margin-left: 6px;
            padding: 2px 5px;
            border-radius: 4px;
            background: #e7f0fb;
            color: #0d477f;
            font-size: 11px;
            font-weight: 800;
        }

        .airport-no-results {
            padding: 14px;
            color: #64748b;
            font-size: 13px;
            line-height: 1.5;
        }

        .airport-field-help {
            display: block;
            margin-top: 6px;
            color: #64748b;
            font-size: 12px;
            line-height: 1.5;
        }

        .airport-directory-status {
            margin: 0 0 18px;
            color: #64748b;
            font-size: 12px;
            line-height: 1.5;
        }

        .airport-directory-status.error {
            color: #9a5a12;
        }

        /* Registration results */

        .registration-success,
        .registration-error {
            margin-top: 20px;
            padding: 16px;
            border-radius: 8px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .registration-success {
            background: #e8f8ef;
            border: 1px solid #c6ebd6;
            color: #126b48;
        }

        .registration-error {
            background: #fff0f0;
            border: 1px solid #f2caca;
            color: #962b32;
        }

        .registration-success h2,
        .registration-error h2 {
            margin-top: 0;
            font-size: 18px;
        }

        #registerButton:disabled {
            opacity: 0.65;
            cursor: wait;
        }

        @media (max-width: 600px) {
            .admin-header .admin-header-inner {
                align-items: flex-start;
                flex-direction: column;
            }

            .dashboard-back-button {
                width: 100%;
                box-sizing: border-box;
            }

            .airport-suggestions {
                max-height: 240px;
            }
        }
    </style>
</head>

<body>

    <div class="admin-container">

        <header class="admin-header">

            <div class="admin-header-inner">

                <div class="admin-header-brand">
                    <h1>ANGEL</h1>
                    <p>Employee Luggage Management</p>
                </div>

                <a
                    href="{{ url_for('employee_dashboard') }}"
                    class="dashboard-back-button"
                >
                    <span aria-hidden="true">&larr;</span>
                    Employee Dashboard
                </a>

            </div>

        </header>

        <main class="admin-content">

            <section class="admin-card">

                <h2>Register New Luggage</h2>

                <p>
                    Enter the passenger, flight and airport information.
                    ANGEL will automatically generate a unique tracking ID.
                </p>

                <p
                    id="airportDirectoryStatus"
                    class="airport-directory-status"
                    role="status"
                    aria-live="polite"
                >
                    Loading the worldwide airport directory...
                </p>

                <form id="luggageForm" autocomplete="off">

                    <label for="passenger">
                        Passenger Name
                    </label>

                    <input
                        type="text"
                        id="passenger"
                        name="passenger"
                        placeholder="Enter passenger full name"
                        required
                    >

                    <label for="flight">
                        Flight Number
                    </label>

                    <input
                        type="text"
                        id="flight"
                        name="flight"
                        placeholder="Example: SA123"
                        required
                    >

                    <label for="origin">
                        Departure Airport
                    </label>

                    <div class="airport-autocomplete">

                        <input
                            type="text"
                            id="origin"
                            name="origin"
                            placeholder="Search airport, city, country or code..."
                            role="combobox"
                            aria-autocomplete="list"
                            aria-expanded="false"
                            aria-controls="originSuggestions"
                            aria-label="Departure airport"
                            required
                        >

                        <div
                            id="originSuggestions"
                            class="airport-suggestions"
                            role="listbox"
                            aria-label="Departure airport suggestions"
                            hidden
                        ></div>

                        <small class="airport-field-help">
                            Select an airport from the suggestions or type a location manually.
                        </small>

                    </div>

                    <label for="destination">
                        Destination Airport
                    </label>

                    <div class="airport-autocomplete">

                        <input
                            type="text"
                            id="destination"
                            name="destination"
                            placeholder="Search airport, city, country or code..."
                            role="combobox"
                            aria-autocomplete="list"
                            aria-expanded="false"
                            aria-controls="destinationSuggestions"
                            aria-label="Destination airport"
                            required
                        >

                        <div
                            id="destinationSuggestions"
                            class="airport-suggestions"
                            role="listbox"
                            aria-label="Destination airport suggestions"
                            hidden
                        ></div>

                        <small class="airport-field-help">
                            Select an airport from the suggestions or type a location manually.
                        </small>

                    </div>

                    <label for="weight">
                        Luggage Weight
                    </label>

                    <input
                        type="text"
                        id="weight"
                        name="weight"
                        placeholder="Example: 18.5 kg"
                        required
                    >

                    <button type="submit" id="registerButton">
                        Register Luggage
                    </button>

                </form>

                <div
                    id="registrationResult"
                    role="status"
                    aria-live="polite"
                ></div>

            </section>

        </main>

    </div>

    <script>
        "use strict";

        /*
         * AIRPORT DIRECTORY
         *
         * Primary source: worldwide airports with scheduled flights.
         * Fallback source: the public-domain OurAirports CSV dataset.
         *
         * Results are cached in localStorage to reduce repeated downloads.
         * If the directory cannot be reached, manual entry remains available.
         */

        const AIRPORT_JSON_URL =
            "https://airportmiles.com/data/airports.json";

        const AIRPORT_CSV_URL =
            "https://davidmegginson.github.io/ourairports-data/airports.csv";

        const AIRPORT_CACHE_KEY = "angelAirportDirectoryV1";
        const AIRPORT_CACHE_DATE_KEY = "angelAirportDirectoryDateV1";
        const AIRPORT_CACHE_MAX_AGE = 30 * 24 * 60 * 60 * 1000;

        let airports = [];
        let airportDirectoryReady = false;

        const countryNames = (() => {
            try {
                return new Intl.DisplayNames(["en"], {
                    type: "region"
                });
            } catch {
                return null;
            }
        })();

        function normaliseText(value) {
            return String(value || "")
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .toLowerCase()
                .trim();
        }

        function readableCountry(value) {
            if (value && typeof value === "object") {
                return value.name || value.common_name ||
                    value.code || value.iso_country || "";
            }

            const country = String(value || "").trim();

            if (/^[A-Z]{2}$/.test(country) && countryNames) {
                try {
                    return countryNames.of(country) || country;
                } catch {
                    return country;
                }
            }

            return country;
        }

        function normaliseAirport(record) {
            if (!record || typeof record !== "object") {
                return null;
            }

            const name = String(
                record.name ||
                record.airport_name ||
                record.airportName ||
                ""
            ).trim();

            const iata = String(
                record.iata ||
                record.iata_code ||
                record.iataCode ||
                ""
            ).trim().toUpperCase();

            const icao = String(
                record.icao ||
                record.icao_code ||
                record.icaoCode ||
                ""
            ).trim().toUpperCase();

            const city = String(
                record.served_city ||
                record.municipality ||
                record.city ||
                record.town ||
                ""
            ).trim();

            const rawCountry =
                record.country ||
                record.country_name ||
                record.countryName ||
                record.iso_country ||
                "";

            const country = readableCountry(rawCountry);

            const keywords = String(record.keywords || "").trim();

            if (!name || !iata) {
                return null;
            }

            const searchText = normaliseText([
                name,
                iata,
                icao,
                city,
                country,
                keywords
            ].join(" "));

            return {
                name,
                iata,
                icao,
                city,
                country,
                searchText
            };
        }

        function getAirportArray(data) {
            if (Array.isArray(data)) {
                return data;
            }

            if (data && Array.isArray(data.airports)) {
                return data.airports;
            }

            if (data && Array.isArray(data.data)) {
                return data.data;
            }

            if (data && Array.isArray(data.results)) {
                return data.results;
            }

            return [];
        }

        function formatAirportValue(airport) {
            const location = [
                airport.city,
                airport.country
            ].filter(Boolean).join(", ");

            const code = airport.iata
                ? ` (${airport.iata})`
                : "";

            return `${airport.name}${code}${location ? " — " + location : ""}`;
        }

        function setDirectoryMessage(message, isError = false) {
            const status = document.getElementById("airportDirectoryStatus");

            status.textContent = message;
            status.classList.toggle("error", isError);
        }

        function setAirportData(data) {
            const rows = getAirportArray(data);

            const cleaned = rows
                .map(normaliseAirport)
                .filter(Boolean);

            const seen = new Set();

            airports = cleaned.filter(airport => {
                const key = `${airport.iata}|${normaliseText(airport.name)}`;

                if (seen.has(key)) {
                    return false;
                }

                seen.add(key);
                return true;
            });

            airportDirectoryReady = airports.length > 0;

            return airportDirectoryReady;
        }

        function saveAirportCache() {
            try {
                localStorage.setItem(
                    AIRPORT_CACHE_KEY,
                    JSON.stringify(airports)
                );

                localStorage.setItem(
                    AIRPORT_CACHE_DATE_KEY,
                    String(Date.now())
                );
            } catch (error) {
                // The dropdown still works if browser storage is unavailable.
                console.warn("ANGEL could not cache the airport directory.", error);
            }
        }

        function loadAirportCache() {
            try {
                const saved = localStorage.getItem(AIRPORT_CACHE_KEY);

                if (!saved) {
                    return false;
                }

                const parsed = JSON.parse(saved);

                return setAirportData(parsed);
            } catch {
                return false;
            }
        }

        function airportCacheIsFresh() {
            try {
                const savedDate = Number(
                    localStorage.getItem(AIRPORT_CACHE_DATE_KEY)
                );

                return savedDate > 0 &&
                    Date.now() - savedDate < AIRPORT_CACHE_MAX_AGE;
            } catch {
                return false;
            }
        }

        /*
         * CSV parser that supports commas inside quoted airport names.
         */

        function parseCSV(text) {
            const rows = [];
            let row = [];
            let cell = "";
            let insideQuotes = false;

            for (let i = 0; i < text.length; i++) {
                const char = text[i];

                if (char === '"') {
                    if (insideQuotes && text[i + 1] === '"') {
                        cell += '"';
                        i++;
                    } else {
                        insideQuotes = !insideQuotes;
                    }
                } else if (char === "," && !insideQuotes) {
                    row.push(cell);
                    cell = "";
                } else if (
                    (char === "\n" || char === "\r") &&
                    !insideQuotes
                ) {
                    if (char === "\r" && text[i + 1] === "\n") {
                        i++;
                    }

                    row.push(cell);
                    cell = "";

                    if (row.some(value => value.trim() !== "")) {
                        rows.push(row);
                    }

                    row = [];
                } else {
                    cell += char;
                }
            }

            if (cell.length || row.length) {
                row.push(cell);
                rows.push(row);
            }

            if (!rows.length) {
                return [];
            }

            const headers = rows.shift().map(header =>
                header.trim().toLowerCase()
            );

            return rows.map(values => {
                const item = {};

                headers.forEach((header, index) => {
                    item[header] = values[index] || "";
                });

                return item;
            });
        }

        async function fetchJSONAirportDirectory() {
            const response = await fetch(AIRPORT_JSON_URL, {
                cache: "no-cache"
            });

            if (!response.ok) {
                throw new Error("Airport JSON source unavailable.");
            }

            const data = await response.json();

            if (!setAirportData(data)) {
                throw new Error("Airport JSON has an unexpected format.");
            }
        }

        async function fetchCSVAirportDirectory() {
            const response = await fetch(AIRPORT_CSV_URL, {
                cache: "no-cache"
            });

            if (!response.ok) {
                throw new Error("Airport CSV source unavailable.");
            }

            const csv = await response.text();
            const rows = parseCSV(csv);

            /*
             * Use facilities with IATA codes and exclude closed airports.
             * The main JSON directory is preferred for scheduled airports.
             */

            const activeRows = rows.filter(record => {
                const code = String(record.iata_code || "").trim();
                const type = String(record.type || "").toLowerCase();

                return code && type !== "closed";
            });

            if (!setAirportData(activeRows)) {
                throw new Error("No usable airport records were received.");
            }
        }

        async function initialiseAirportDirectory() {
            const hasCached = loadAirportCache();

            if (hasCached) {
                setDirectoryMessage(
                    `Airport directory ready: ${airports.length.toLocaleString()} airports.`
                );

                document.dispatchEvent(
                    new CustomEvent("angel-airports-ready")
                );

                if (airportCacheIsFresh()) {
                    return;
                }
            } else {
                setDirectoryMessage(
                    "Loading worldwide airports. You can type manually while it loads..."
                );
            }

            try {
                try {
                    await fetchJSONAirportDirectory();
                } catch (jsonError) {
                    console.warn(
                        "ANGEL will try the fallback airport directory.",
                        jsonError
                    );

                    await fetchCSVAirportDirectory();
                }

                saveAirportCache();

                setDirectoryMessage(
                    `Airport directory ready: ${airports.length.toLocaleString()} airports. You can also type a location manually.`
                );

                document.dispatchEvent(
                    new CustomEvent("angel-airports-ready")
                );

            } catch (error) {
                console.error("Airport directory could not be loaded.", error);

                if (hasCached && airportDirectoryReady) {
                    setDirectoryMessage(
                        "Using the previously saved airport directory. Manual entry is also available.",
                        true
                    );
                } else {
                    setDirectoryMessage(
                        "The airport directory is unavailable right now. You can still type airport names or locations manually.",
                        true
                    );
                }
            }
        }

        /*
         * SEARCHABLE DROPDOWN
         */

        function setupAirportAutocomplete(inputId, suggestionsId) {
            const input = document.getElementById(inputId);
            const suggestions = document.getElementById(suggestionsId);
            const wrapper = input.closest(".airport-autocomplete");

            let results = [];
            let activeIndex = -1;

            function closeSuggestions() {
                suggestions.hidden = true;
                input.setAttribute("aria-expanded", "false");
                input.removeAttribute("aria-activedescendant");
                activeIndex = -1;
            }

            function markActive(index) {
                const options = suggestions.querySelectorAll(".airport-option");

                if (!options.length) {
                    activeIndex = -1;
                    return;
                }

                if (index < 0) {
                    index = options.length - 1;
                }

                if (index >= options.length) {
                    index = 0;
                }

                activeIndex = index;

                options.forEach((option, optionIndex) => {
                    const isActive = optionIndex === activeIndex;

                    option.classList.toggle("active", isActive);
                    option.setAttribute("aria-selected", String(isActive));

                    if (isActive) {
                        input.setAttribute(
                            "aria-activedescendant",
                            option.id
                        );

                        option.scrollIntoView({
                            block: "nearest"
                        });
                    }
                });
            }

            function selectAirport(airport) {
                input.value = formatAirportValue(airport);
                closeSuggestions();

                input.dispatchEvent(
                    new Event("change", {
                        bubbles: true
                    })
                );
            }

            function renderSuggestions() {
                const query = normaliseText(input.value);

                suggestions.replaceChildren();
                results = [];
                activeIndex = -1;

                if (query.length < 2) {
                    closeSuggestions();
                    return;
                }

                if (!airportDirectoryReady) {
                    closeSuggestions();
                    return;
                }

                results = airports
                    .filter(airport => airport.searchText.includes(query))
                    .sort((a, b) => {
                        function rank(airport) {
                            if (normaliseText(airport.iata) === query) {
                                return 0;
                            }

                            if (normaliseText(airport.name).startsWith(query)) {
                                return 1;
                            }

                            if (normaliseText(airport.city).startsWith(query)) {
                                return 2;
                            }

                            return 3;
                        }

                        return rank(a) - rank(b) ||
                            a.name.localeCompare(b.name);
                    })
                    .slice(0, 12);

                if (results.length === 0) {
                    const empty = document.createElement("div");

                    empty.className = "airport-no-results";
                    empty.textContent =
                        "No matching airport found. You can continue typing your location manually.";

                    suggestions.appendChild(empty);
                    suggestions.hidden = false;
                    input.setAttribute("aria-expanded", "true");

                    return;
                }

                results.forEach((airport, index) => {
                    const option = document.createElement("button");

                    option.type = "button";
                    option.className = "airport-option";
                    option.id = `${suggestionsId}-option-${index}`;
                    option.setAttribute("role", "option");
                    option.setAttribute("aria-selected", "false");

                    const name = document.createElement("span");
                    name.className = "airport-option-name";
                    name.textContent = airport.name;

                    if (airport.iata) {
                        const code = document.createElement("span");

                        code.className = "airport-code";
                        code.textContent = airport.iata;

                        name.appendChild(code);
                    }

                    const details = document.createElement("span");
                    details.className = "airport-option-details";

                    details.textContent = [
                        airport.city,
                        airport.country,
                        airport.icao ? `ICAO: ${airport.icao}` : ""
                    ].filter(Boolean).join(" · ");

                    option.append(name, details);

                    /*
                     * Prevent the input losing focus before the option is clicked.
                     */

                    option.addEventListener("pointerdown", event => {
                        event.preventDefault();
                    });

                    option.addEventListener("click", () => {
                        selectAirport(airport);
                    });

                    suggestions.appendChild(option);
                });

                suggestions.hidden = false;
                input.setAttribute("aria-expanded", "true");
            }

            input.addEventListener("input", renderSuggestions);

            input.addEventListener("focus", renderSuggestions);

            input.addEventListener("keydown", event => {
                if (event.key === "ArrowDown") {
                    if (suggestions.hidden) {
                        renderSuggestions();
                    }

                    if (!suggestions.hidden && results.length) {
                        event.preventDefault();
                        markActive(activeIndex + 1);
                    }

                } else if (event.key === "ArrowUp") {
                    if (!suggestions.hidden && results.length) {
                        event.preventDefault();
                        markActive(activeIndex - 1);
                    }

                } else if (event.key === "Enter") {
                    if (!suggestions.hidden && results.length) {
                        event.preventDefault();

                        const index = activeIndex >= 0
                            ? activeIndex
                            : 0;

                        selectAirport(results[index]);
                    }

                } else if (event.key === "Escape") {
                    closeSuggestions();
                }
            });

            document.addEventListener("click", event => {
                if (!wrapper.contains(event.target)) {
                    closeSuggestions();
                }
            });

            /*
             * Re-render if airport data loads after the employee has already
             * started typing.
             */

            document.addEventListener("angel-airports-ready", () => {
                if (document.activeElement === input) {
                    renderSuggestions();
                }
            });
        }

        setupAirportAutocomplete("origin", "originSuggestions");

        setupAirportAutocomplete(
            "destination",
            "destinationSuggestions"
        );

        /*
         * LUGGAGE REGISTRATION
         *
         * The origin and destination field names are unchanged so the existing
         * Flask /admin/add endpoint can continue receiving them.
         */

        const luggageForm = document.getElementById("luggageForm");
        const registrationResult = document.getElementById("registrationResult");
        const registerButton = document.getElementById("registerButton");

        luggageForm.addEventListener("submit", async function (event) {
            event.preventDefault();

            if (!luggageForm.reportValidity()) {
                return;
            }

            registerButton.disabled = true;
            registerButton.textContent = "Registering...";
            registrationResult.replaceChildren();

            try {
                const response = await fetch("/admin/add", {
                    method: "POST",
                    credentials: "same-origin",
                    body: new FormData(luggageForm)
                });

                let data;

                try {
                    data = await response.json();
                } catch {
                    throw new Error(
                        "The server returned an unexpected response."
                    );
                }

                if (!response.ok || !data.success) {
                    throw new Error(
                        data.message || "Unable to register the luggage."
                    );
                }

                const successBox = document.createElement("div");
                successBox.className = "registration-success";

                const heading = document.createElement("h2");
                heading.textContent = "Luggage Registered";

                const confirmation = document.createElement("p");
                confirmation.textContent =
                    "The luggage has been successfully registered.";

                const tracking = document.createElement("p");
                const trackingLabel = document.createElement("strong");

                trackingLabel.textContent = "Tracking ID: ";
                tracking.appendChild(trackingLabel);
                tracking.appendChild(
                    document.createTextNode(data.tracking_id || "")
                );

                const instruction = document.createElement("p");
                instruction.textContent =
                    "This tracking ID can now be used to track the luggage.";

                successBox.append(
                    heading,
                    confirmation,
                    tracking,
                    instruction
                );

                registrationResult.replaceChildren(successBox);
                luggageForm.reset();

            } catch (error) {
                const errorBox = document.createElement("div");
                errorBox.className = "registration-error";

                const heading = document.createElement("h2");
                heading.textContent = "Registration Failed";

                const message = document.createElement("p");
                message.textContent =
                    error.message || "ANGEL could not register the luggage.";

                errorBox.append(heading, message);
                registrationResult.replaceChildren(errorBox);

            } finally {
                registerButton.disabled = false;
                registerButton.textContent = "Register Luggage";
            }
        });

        initialiseAirportDirectory();
    </script>

</body>

</html>
