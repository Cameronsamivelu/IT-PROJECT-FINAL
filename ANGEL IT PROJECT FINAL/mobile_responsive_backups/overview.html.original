<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ANGEL - System Overview</title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='css/style.css') }}">

</head>

<body>

    <div class="employees-page">

        <!-- HEADER -->

        <header class="employees-header">

            <div>

                <h1>ANGEL</h1>

                <p>System Overview</p>

            </div>

            <a href="{{ url_for('management') }}"
               class="employees-back-button">

                ← Management Dashboard

            </a>

        </header>


        <!-- MAIN CONTENT -->

        <main class="employees-content">


            <!-- PAGE INTRO -->

            <div class="employee-list-card">

                <h2>ANGEL System Overview</h2>

                <p>
                    View a summary of employee accounts and luggage
                    currently registered in the ANGEL system.
                </p>


                <!-- EMPLOYEE STATISTICS -->

                <h2 style="margin-top: 35px;">
                    Employee Statistics
                </h2>

                <div style="
                    display: grid;
                    grid-template-columns: repeat(3, 1fr);
                    gap: 20px;
                    margin-top: 20px;
                ">


                    <!-- TOTAL EMPLOYEES -->

                    <div style="
                        background: #eef5ff;
                        padding: 25px;
                        border-radius: 12px;
                        text-align: center;
                        border: 1px solid #dce8f5;
                    ">

                        <div style="
                            font-size: 32px;
                            font-weight: bold;
                            color: #003b73;
                        ">
                            {{ statistics["total_employees"] }}
                        </div>

                        <div style="
                            margin-top: 8px;
                            color: #666;
                            font-weight: 600;
                        ">
                            Total Employees
                        </div>

                    </div>


                    <!-- ACTIVE EMPLOYEES -->

                    <div style="
                        background: #e7f7ed;
                        padding: 25px;
                        border-radius: 12px;
                        text-align: center;
                        border: 1px solid #c8ead5;
                    ">

                        <div style="
                            font-size: 32px;
                            font-weight: bold;
                            color: #218838;
                        ">
                            {{ statistics["active_employees"] }}
                        </div>

                        <div style="
                            margin-top: 8px;
                            color: #666;
                            font-weight: 600;
                        ">
                            Active Employees
                        </div>

                    </div>


                    <!-- DISABLED EMPLOYEES -->

                    <div style="
                        background: #fdeaea;
                        padding: 25px;
                        border-radius: 12px;
                        text-align: center;
                        border: 1px solid #f1caca;
                    ">

                        <div style="
                            font-size: 32px;
                            font-weight: bold;
                            color: #c9302c;
                        ">
                            {{ statistics["disabled_employees"] }}
                        </div>

                        <div style="
                            margin-top: 8px;
                            color: #666;
                            font-weight: 600;
                        ">
                            Disabled Employees
                        </div>

                    </div>

                </div>


                <!-- LUGGAGE STATISTICS -->

                <h2 style="margin-top: 45px;">
                    Luggage Statistics
                </h2>

                <div style="
                    display: grid;
                    grid-template-columns: repeat(3, 1fr);
                    gap: 20px;
                    margin-top: 20px;
                ">


                    <!-- TOTAL LUGGAGE -->

                    <div style="
                        background: #eef5ff;
                        padding: 25px;
                        border-radius: 12px;
                        text-align: center;
                        border: 1px solid #dce8f5;
                    ">

                        <div style="
                            font-size: 32px;
                            font-weight: bold;
                            color: #003b73;
                        ">
                            {{ statistics["total_luggage"] }}
                        </div>

                        <div style="
                            margin-top: 8px;
                            color: #666;
                            font-weight: 600;
                        ">
                            Total Luggage
                        </div>

                    </div>


                    <!-- CHECKED IN -->

                    <div style="
                        background: #f7faff;
                        padding: 25px;
                        border-radius: 12px;
                        text-align: center;
                        border: 1px solid #dce8f5;
                    ">

                        <div style="
                            font-size: 32px;
                            font-weight: bold;
                            color: #003b73;
                        ">
                            {{ statistics["checked_in"] }}
                        </div>

                        <div style="
                            margin-top: 8px;
                            color: #666;
                            font-weight: 600;
                        ">
                            Checked In
                        </div>

                    </div>


                    <!-- LOADED -->

                    <div style="
                        background: #f7faff;
                        padding: 25px;
                        border-radius: 12px;
                        text-align: center;
                        border: 1px solid #dce8f5;
                    ">

                        <div style="
                            font-size: 32px;
                            font-weight: bold;
                            color: #003b73;
                        ">
                            {{ statistics["loaded"] }}
                        </div>

                        <div style="
                            margin-top: 8px;
                            color: #666;
                            font-weight: 600;
                        ">
                            Loaded onto Aircraft
                        </div>

                    </div>


                    <!-- IN TRANSIT -->

                    <div style="
                        background: #f7faff;
                        padding: 25px;
                        border-radius: 12px;
                        text-align: center;
                        border: 1px solid #dce8f5;
                    ">

                        <div style="
                            font-size: 32px;
                            font-weight: bold;
                            color: #003b73;
                        ">
                            {{ statistics["transit"] }}
                        </div>

                        <div style="
                            margin-top: 8px;
                            color: #666;
                            font-weight: 600;
                        ">
                            In Transit
                        </div>

                    </div>


                    <!-- DELAYED -->

                    <div style="
                        background: #fff8e1;
                        padding: 25px;
                        border-radius: 12px;
                        text-align: center;
                        border: 1px solid #f0d98a;
                    ">

                        <div style="
                            font-size: 32px;
                            font-weight: bold;
                            color: #8a6d00;
                        ">
                            {{ statistics["delayed"] }}
                        </div>

                        <div style="
                            margin-top: 8px;
                            color: #666;
                            font-weight: 600;
                        ">
                            Delayed
                        </div>

                    </div>


                    <!-- LOST -->

                    <div style="
                        background: #fdeaea;
                        padding: 25px;
                        border-radius: 12px;
                        text-align: center;
                        border: 1px solid #f1caca;
                    ">

                        <div style="
                            font-size: 32px;
                            font-weight: bold;
                            color: #c9302c;
                        ">
                            {{ statistics["lost"] }}
                        </div>

                        <div style="
                            margin-top: 8px;
                            color: #666;
                            font-weight: 600;
                        ">
                            Lost
                        </div>

                    </div>

                </div>


                <!-- SUMMARY -->

                <div style="
                    margin-top: 40px;
                    padding: 20px;
                    background: #f7faff;
                    border: 1px solid #dce8f5;
                    border-radius: 10px;
                    text-align: center;
                ">

                    <strong style="color: #003b73;">
                        ANGEL System Status
                    </strong>

                    <p style="
                        width: 100%;
                        margin-top: 8px;
                        color: #666;
                        font-size: 14px;
                    ">
                        The figures above represent the current
                        information stored in the ANGEL database.
                    </p>

                </div>

            </div>

        </main>

    </div>


    <!-- RESPONSIVE -->

    <style>

        @media (max-width: 800px) {

            .employee-list-card > div[style*="grid-template-columns"] {
                grid-template-columns: 1fr !important;
            }

        }

    </style>

</body>

</html>